# Copie para Streamlit Cloud → Settings → Secrets
# (mesmo bloco [connections.gsheets] do velocímetro)

[connections.gsheets]
type = "service_account"
private_key = """
-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""
client_email = "sua-conta@projeto.iam.gserviceaccount.com"
# spreadsheet_id abaixo é da planilha consolidada do velocímetro — NÃO usada aqui
spreadsheet_id = "..."

# Opcional: sobrescrever ID da planilha do Brasileirão
# [brasileirao]
# spreadsheet_id = "1QkOIvRa9YinnOveOK4BkX4h_ZtGYRg1ZLzIfokbQh5I"

# --- Pipeline probabilístico / Google Drive (base FPT única) ---
# NÃO commitar o JSON da service account.
# No Streamlit Cloud, use Secrets; localmente exporte env vars.
#
# GOOGLE_DRIVE_FILE_ID = "..."
# GOOGLE_DRIVE_FILE_URL = "https://drive.google.com/file/d/.../view"
# GOOGLE_SERVICE_ACCOUNT_JSON = """{ ... service account json ... }"""
#
# Ou em config/prob_ml.yaml:
#   data.source: google_drive
#   data.google_drive_file_id: "..."
