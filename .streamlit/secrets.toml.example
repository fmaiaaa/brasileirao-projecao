# Copie para Streamlit Cloud → Settings → Secrets
# (mesmo bloco [connections.gsheets] do velocímetro)

[connections.gsheets]
type = "service_account"
private_key = """
-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""
client_email = "sua-conta@projeto.iam.gserviceaccount.com"
# spreadsheet_id abaixo é da planilha consolidada do velocímetro — NÃO usada aqui
spreadsheet_id = "..."

# Opcional: sobrescrever ID da planilha do Brasileirão
# [brasileirao]
# spreadsheet_id = "1QkOIvRa9YinnOveOK4BkX4h_ZtGYRg1ZLzIfokbQh5I"

# --- Pipeline probabilístico / Google Drive (base FPT única) ---
# File ID já configurado em config/prob_ml.yaml:
#   12rP2nVmKF-VMyY1Oq47Oo7H34ADfxbTV
#
# Compartilhe o arquivo no Drive (Viewer) com a service account do Streamlit:
#   streamlit-bot@bot-promocional.iam.gserviceaccount.com
#
# As credenciais podem ser as mesmas de [connections.gsheets] (já usadas no app).
# Opcionalmente também:
#
# GOOGLE_DRIVE_FILE_ID = "12rP2nVmKF-VMyY1Oq47Oo7H34ADfxbTV"
# GOOGLE_DRIVE_FILE_URL = "https://drive.google.com/file/d/12rP2nVmKF-VMyY1Oq47Oo7H34ADfxbTV/view?usp=sharing"
# GOOGLE_SERVICE_ACCOUNT_JSON = """{ ... JSON da service account ... }"""
#
# Em config/prob_ml.yaml: data.source = "google_drive"
