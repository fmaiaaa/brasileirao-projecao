# Copie para Streamlit Cloud → Settings → Secrets
# (mesmo bloco [connections.gsheets] do velocímetro)

[connections.gsheets]
type = "service_account"
private_key = """
-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""
client_email = "sua-conta@projeto.iam.gserviceaccount.com"
# spreadsheet_id abaixo é da planilha consolidada do velocímetro — NÃO usada aqui
spreadsheet_id = "..."

# Opcional: sobrescrever ID da planilha do Brasileirão
# [brasileirao]
